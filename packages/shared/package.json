{
  "name": "@workspace/shared",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "typescript": "^5"
  },
  "exports": {
    "./types/*": "./src/types/*.ts",
    "./data/*": "./src/data/*.ts",
    "./lib/*": "./src/lib/*.ts"
  }
}
